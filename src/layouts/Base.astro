---
import '@fontsource-variable/geist/wght.css';
import '@fontsource/instrument-serif/latin-400-italic.css';
import '@fontsource/geist-mono/latin-400.css';
import '@fontsource/geist-mono/latin-500.css';
import '../styles/global.css';
import Backdrop from '../components/Backdrop.astro';
import { profile } from '../data/profile';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
}

const {
  title,
  description = profile.description,
  image = '/og.png',
  type = 'website',
} = Astro.props;

// The browser tab reads "Frederick | Portfolio" (a page's own title goes in front); link previews keep the full name.
const tabTitle = `${profile.firstName} | Portfolio`;
const fullTitle = title ? `${title} | ${tabTitle}` : tabTitle;
const shareTitle = title ? `${title} · ${profile.name}` : `${profile.name} · Portfolio`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  jobTitle: profile.role,
  address: { '@type': 'PostalAddress', addressLocality: 'Legazpi City', addressRegion: 'Albay', addressCountry: 'PH' },
  sameAs: [profile.github, profile.linkedin],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#0b0b0c" />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:type" content={type} />
    <meta property="og:title" content={shareTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content={profile.name} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={shareTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Runs before paint: turns on the motion states. -->
    <link rel="preload" href="/fonts/eternalo.woff2" as="font" type="font/woff2" crossorigin />

    <script is:inline>
      (() => {
        document.documentElement.classList.add('js');
      })();
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(person)} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Backdrop />
    <slot />
    <script>
      // Reveal each marked element once as it scrolls into view. Content is never left hidden.
      const targets = document.querySelectorAll<HTMLElement>('[data-reveal]');
      const show = (el: Element) => el.classList.add('is-in');
      if (!('IntersectionObserver' in window)) {
        targets.forEach(show);
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              show(entry.target);
              io.unobserve(entry.target);
            }
          },
          { rootMargin: '0px 0px -10% 0px', threshold: 0.08 },
        );
        targets.forEach((el) => io.observe(el));
        window.addEventListener('load', () =>
          setTimeout(() => {
            targets.forEach((el) => {
              const r = el.getBoundingClientRect();
              if (r.top < innerHeight && r.bottom > 0) show(el);
            });
          }, 2500),
        );
      }
    </script>
  </body>
</html>
