---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

// One project as a compact card: cover, title, what it is and the year. The whole card opens the
// project's page, where the role, stack, links and screenshots live.
interface Props {
  project: CollectionEntry<'projects'>;
  index: number;
}

const { project, index } = Astro.props;
const { title, kind, year, ongoing, screenshots } = project.data;
const href = `/projects/${project.id}/`;
const cover = screenshots[0];
---

<article class="project card" data-reveal style={`--d:${index}`}>
  <div class="project__cover">
    <Image
      class="shot"
      src={cover.src}
      alt=""
      widths={[340, 580, 720]}
      sizes="(min-width: 1100px) 290px, 340px"
      quality={78}
      format="webp"
      loading="lazy"
    />
  </div>
  <div class="project__body">
    <h3 class="project__title">
      <a href={href} title={`Open ${title}`}>{title}</a>
    </h3>
    <p class="project__kind accent soft">{kind}</p>
    <div class="project__foot">
      <span class="kicker">{ongoing ? `${year} – Present` : year}</span>
      <span class="project__open kicker" aria-hidden="true">
        View
        <svg width="12" height="12" viewBox="0 0 14 14"><path d="M3 11L11 3M5 3h6v6" fill="none" stroke="currentColor" stroke-width="1.5"></path></svg>
      </span>
    </div>
  </div>
</article>

<style>
  .project {
    position: relative;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    transition: transform 400ms var(--ease-out), border-color var(--t-hover) ease;
  }
  .project__cover {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    margin: 8px 8px 0;
    border-radius: var(--radius);
    background: var(--tone);
  }
  .project__cover :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top left;
    transition: transform 700ms var(--ease-out);
  }
  .project__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 6px;
    padding: 18px 20px 18px;
  }
  .project__title {
    font-family: var(--display);
    font-size: clamp(1.75rem, 1.4rem + 0.8vw, 2.25rem);
    font-weight: 400;
    line-height: 1;
    letter-spacing: 0.005em;
  }
  .project__title a {
    text-decoration: none;
  }
  /* The title link covers the whole card, so anywhere on it opens the project. */
  .project__title a::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    border-radius: inherit;
  }
  .project__kind {
    font-size: var(--step-body);
    line-height: 1.3;
  }
  .project__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: auto;
    padding-top: 14px;
  }
  .project__open {
    gap: 6px;
    color: var(--ink);
    transition: transform 300ms var(--ease-out);
  }
  .project:has(a:focus-visible) {
    outline: 2px solid var(--ink);
    outline-offset: 3px;
  }
  .project__title a:focus-visible {
    outline: none;
  }
  @media (hover: hover) and (pointer: fine) {
    .project:hover {
      transform: translateY(-4px);
      border-color: var(--tone-2);
    }
    .project:hover .project__cover :global(img) {
      transform: scale(1.04);
    }
    .project:hover .project__open {
      transform: translateX(3px);
    }
  }
</style>
