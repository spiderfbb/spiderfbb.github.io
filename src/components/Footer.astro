---
import { profile } from '../data/profile';

const year = new Date().getFullYear();
---

<footer class="foot no-print">
  <div class="container foot__inner">
    <a class="foot__brand" href="/" title="Back to the top of the home page">
      <span class="foot__mark" aria-hidden="true"></span>
      <span>
        <strong>{profile.name}</strong>
        <span class="soft small">{profile.role}</span>
      </span>
    </a>
    <ul class="foot__links" role="list">
      <li><a class="link" href={profile.github} rel="noopener" target="_blank" title="GitHub profile (opens in a new tab)">GitHub</a></li>
      <li><a class="link" href={profile.linkedin} rel="noopener" target="_blank" title="LinkedIn profile (opens in a new tab)">LinkedIn</a></li>
      <li><a class="link" href={profile.resume} download={profile.resumeFile} title="Download my résumé as a PDF">Résumé</a></li>
      <li><a class="link" href={`mailto:${profile.email}`} title="Write me an email">Email</a></li>
    </ul>
    <p class="foot__copy soft small">© {year} {profile.name}</p>
  </div>
</footer>

<style>
  .foot {
    padding-block: 40px 48px;
    border-top: 1px solid var(--line); /* taste-skill-ignore: footer edge, owner-approved */
  }
  .foot__inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 24px;
  }
  .foot__brand {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
  }
  .foot__brand > span:last-child {
    display: grid;
    line-height: 1.35;
  }
  .foot__brand strong {
    font-weight: 500;
  }
  .foot__mark {
    display: inline-grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: var(--ink);
    color: var(--ground);
    font-size: var(--step-small);
    font-weight: 700;
  }
  .foot__links {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 24px;
    font-size: var(--step-small);
  }
  .foot__links a {
    display: inline-flex;
    align-items: center;
    min-height: 36px;
  }
  .foot__copy {
    text-align: right;
  }
  @media (max-width: 760px) {
    .foot__inner {
      grid-template-columns: minmax(0, 1fr);
      gap: 16px;
    }
    .foot__copy {
      text-align: left;
    }
  }
</style>
