---
import { profile } from '../data/profile';

// Works on free static hosting. With profile.formEndpoint set (Formspree or similar) it posts there;
// otherwise it opens the visitor's email app with the message already written.
const endpoint = profile.formEndpoint;
const action = endpoint || `mailto:${profile.email}`;
---

<form
  class="form"
  action={action}
  method="post"
  enctype={endpoint ? undefined : 'text/plain'}
  data-contact-form
  data-endpoint={endpoint}
  data-email={profile.email}
  data-reveal
  style="--d:1"
>
  <div class="form__field">
    <label for="cf-name">Your name</label>
    <input id="cf-name" name="name" type="text" autocomplete="name" required />
  </div>
  <div class="form__field">
    <label for="cf-email">Your email</label>
    <input id="cf-email" name="email" type="email" autocomplete="email" spellcheck="false" required />
  </div>
  <div class="form__field">
    <label for="cf-message">Message</label>
    <textarea id="cf-message" name="message" rows="5" required placeholder="What would you like to talk about…"></textarea>
  </div>
  <div class="form__foot">
    <button class="button" type="submit" title="Send this message">Send message</button>
    <p class="form__status small" role="status" aria-live="polite" data-status></p>
  </div>
</form>

<style>
  .form {
    display: grid;
    gap: 18px;
    width: 100%;
  }
  .form__field {
    display: grid;
    gap: 6px;
  }
  label {
    font-size: var(--step-small);
    font-weight: 500;
  }
  input,
  textarea {
    width: 100%;
    min-height: var(--control);
    padding: 10px 12px;
    background: var(--ground);
    border: 1.5px solid transparent;
    border-radius: 12px;
    font-size: var(--step-body);
    transition: border-color var(--t-hover) ease, background-color var(--t-hover) ease;
  }
  textarea {
    resize: vertical;
  }
  input:hover,
  textarea:hover {
    border-color: var(--tone-2);
  }
  input,
  textarea {
    padding: 12px 16px;
  }
  input:focus,
  textarea:focus {
    outline: none;
    border-color: var(--ink);
  }
  ::placeholder {
    color: var(--soft);
    opacity: 1;
  }
  .form__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 20px;
  }
  .form__status:empty {
    display: none;
  }
</style>

<script>
  document.querySelectorAll<HTMLFormElement>('[data-contact-form]').forEach((form) => {
    const status = form.querySelector<HTMLElement>('[data-status]');
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const say = (text: string) => {
      if (status) status.textContent = text;
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!form.reportValidity()) return;
      const data = new FormData(form);
      const endpoint = form.dataset.endpoint;

      if (!endpoint) {
        const subject = `Message from ${data.get('name')}`;
        const body = `${data.get('message')}\n\n${data.get('name')}\n${data.get('email')}`;
        window.location.href = `mailto:${form.dataset.email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
        say('Your email app should open with the message ready to send.');
        return;
      }

      button?.setAttribute('disabled', '');
      say('Sending…');
      try {
        const response = await fetch(endpoint, { method: 'POST', body: data, headers: { Accept: 'application/json' } });
        if (!response.ok) throw new Error(String(response.status));
        form.reset();
        say('Thanks, your message was sent. I’ll reply by email.');
      } catch {
        say(`That didn’t go through. Please email me at ${form.dataset.email} instead.`);
      } finally {
        button?.removeAttribute('disabled');
      }
    });
  });
</script>
