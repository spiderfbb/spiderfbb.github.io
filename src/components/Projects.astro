---
import type { CollectionEntry } from 'astro:content';
import ProjectCard from './ProjectCard.astro';

interface Props {
  projects: CollectionEntry<'projects'>[];
}

const { projects } = Astro.props;
// Two projects still fit side by side on a tablet, so they only become a swipeable row on phones.
const few = projects.length <= 2;
---

<section id="projects" class:list={['section projects', { 'projects--few': few }]} aria-labelledby="projects-title">
  <div class="container">
    <div class="section-head">
      <div data-reveal>
        <p class="kicker"><svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="M1 1l10 10M11 3v8H3" fill="none" stroke="currentColor" stroke-width="1.3"></path></svg><span>Selected /</span> <b>Work</b></p>
        <h2 id="projects-title">Projects</h2>
        <p class="accent">Client work, from first sketch to launch.</p>
      </div>
    </div>
    <p class="projects__hint kicker" aria-hidden="true">Swipe for more <span>→</span></p>
  </div>
  <!-- One row: a column per project on wide screens, a swipeable row on smaller ones. -->
  <div class="projects__row" role="list" tabindex="0" aria-label="Projects (scroll sideways on small screens)" style={`--count:${projects.length}`}>
    {
      projects.map((project, i) => (
        <div class="projects__item" role="listitem">
          <ProjectCard project={project} index={i} />
        </div>
      ))
    }
  </div>
</section>

<style>
  .projects__row {
    display: grid;
    grid-template-columns: repeat(var(--count, 3), minmax(0, 1fr));
    gap: 20px;
    width: min(var(--container), 100% - 2 * var(--m));
    margin-inline: auto;
  }
  .projects__item {
    display: flex;
  }
  .projects__item > :global(*) {
    flex: 1;
  }
  .projects__hint {
    display: none;
    margin: -16px 0 16px;
  }
  .projects__row:focus-visible {
    outline-offset: 8px;
    border-radius: var(--radius-lg);
  }

  @media (max-width: 1100px) {
    .projects__hint {
      display: flex;
    }
    .projects__row {
      grid-template-columns: none;
      grid-auto-flow: column;
      grid-auto-columns: min(340px, 82vw);
      width: 100%;
      padding: 4px max(var(--m), (100% - var(--container)) / 2) 16px;
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: var(--m);
      scrollbar-width: thin;
    }
    .projects__item {
      scroll-snap-align: start;
    }
  }

  @media (min-width: 721px) and (max-width: 1100px) {
    .projects--few .projects__hint {
      display: none;
    }
    .projects--few .projects__row {
      grid-template-columns: repeat(var(--count, 2), minmax(0, 1fr));
      grid-auto-flow: row;
      width: min(var(--container), 100% - 2 * var(--m));
      padding: 0;
      overflow: visible;
      scroll-snap-type: none;
    }
  }
</style>
