---
import { Image } from 'astro:assets';
import { render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import { getActivities, getProjects } from '../../lib/content';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: { project, next: projects[(i + 1) % projects.length] },
  }));
}

interface Props {
  project: CollectionEntry<'projects'>;
  next: CollectionEntry<'projects'>;
}

const { project, next } = Astro.props;
const { title, kind, summary, client, role, team, year, ongoing, stack, links, screenshots } = project.data;
const { Content } = await render(project);
const hasActivities = (await getActivities()).length > 0;
const [first, ...rest] = screenshots;

const facts = [
  { label: 'Client', value: client },
  { label: 'My role', value: role },
  ...(team ? [{ label: 'Team', value: team }] : []),
  { label: 'Year', value: ongoing ? `${year} – Present (in development)` : String(year) },
];
---

<Base title={title} description={summary} type="article">
  <Navbar hasActivities={hasActivities} />
  <main id="main">
    <section class="section project-head">
      <div class="container">
        <a class="back" href="/#projects" title="Back to all projects">
          <span aria-hidden="true">←</span> All projects
        </a>
        <h1 class="project-head__title">{title}</h1>
        <p class="project-head__kind accent">{kind}</p>
        <p class="project-head__summary">{summary}</p>
        {
          links.demo && (
            <div class="project-head__links">
              <a class="button" href={links.demo} rel="noopener" target="_blank" title="Open the live app in a new tab">
                Visit the live app
                <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path d="M3 11L11 3M5 3h6v6" fill="none" stroke="currentColor" stroke-width="1.5"></path></svg>
              </a>
            </div>
          )
        }
      </div>
    </section>

    <div class="container">
      <figure class="lead-media" data-reveal>
        <Image
          class="shot"
          src={first.src}
          alt={first.alt}
          widths={[640, 1000, 1400, 2000]}
          sizes="(min-width: 1240px) 1200px, 100vw"
          quality={80}
          format="webp"
          loading="eager"
        />
      </figure>
    </div>

    <section class="section">
      <div class="container project-body">
        <aside class="facts card" data-reveal>
          <dl>
            {
              facts.map((fact) => (
                <div>
                  <dt class="soft small">{fact.label}</dt>
                  <dd>{fact.value}</dd>
                </div>
              ))
            }
          </dl>
          <div>
            <p class="soft small">Built with</p>
            <ul class="chips" role="list">
              {stack.map((tech) => <li class="chip">{tech}</li>)}
            </ul>
          </div>
        </aside>
        <div class="prose" data-reveal style="--d:1">
          <Content />
        </div>
      </div>
    </section>

    {
      rest.length > 0 && (
        <section class="section section--band" aria-labelledby="screens-title">
          <div class="container">
            <div class="section-head" data-reveal>
              <div>
                <p class="kicker"><svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="M1 1l10 10M11 3v8H3" fill="none" stroke="currentColor" stroke-width="1.3"></path></svg><span>Gallery /</span> <b>Highlights</b></p>
                <h2 id="screens-title">Highlights</h2>
                <p>A closer look at the best parts.</p>
              </div>
            </div>
            <ul role="list" class="gallery">
              {
                rest.map((shot, i) => (
                  <li data-reveal style={`--d:${i % 2}`}>
                    <figure>
                      <Image
                        class="shot"
                        src={shot.src}
                        alt={shot.alt}
                        widths={[480, 800, 1200]}
                        sizes="(min-width: 900px) 600px, 100vw"
                        quality={78}
                        format="webp"
                        loading="lazy"
                      />
                      <figcaption class="small soft">{shot.alt}</figcaption>
                    </figure>
                  </li>
                ))
              }
            </ul>
          </div>
        </section>
      )
    }

    <section class="section">
      <div class="container">
        <a class="next card" href={`/projects/${next.id}/`} title={`Next project: ${next.data.title}`} data-reveal>
          <span class="soft">Next project</span>
          <span class="next__title">{next.data.title}</span>
          <span class="next__kind soft">{next.data.kind}</span>
          <span class="next__arrow" aria-hidden="true">→</span>
        </a>
      </div>
    </section>
  </main>
  <Footer />
</Base>

<style>
  .project-head {
    padding-bottom: clamp(40px, 5vw, 64px);
  }
  .back {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 36px;
    padding: 0 14px;
    border-radius: 999px;
    background: var(--tone);
    font-size: var(--step-small);
    text-decoration: none;
    transition: background-color var(--t-hover) ease;
  }
  @media (hover: hover) and (pointer: fine) {
    .back:hover {
      background: var(--tone-2);
    }
  }
  .project-head__title {
    margin-top: 28px;
    font-size: var(--step-display);
    line-height: 0.98;
    letter-spacing: 0.005em;
  }
  .project-head__kind {
    margin-top: 14px;
    font-size: clamp(1.5rem, 1.2rem + 1.2vw, 2.25rem);
    line-height: 1.2;
    color: var(--soft);
    text-align: left;
  }
  .project-head__summary {
    max-width: 38em;
    margin-top: 20px;
    font-size: var(--step-lead);
    line-height: 1.55;
  }
  .project-head__links {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 32px;
  }

  .lead-media {
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: var(--tone);
  }
  .lead-media :global(img) {
    width: 100%;
    max-height: 720px;
    object-fit: cover;
    object-position: top center;
  }

  .project-body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    align-items: start;
    gap: clamp(32px, 6vw, 96px);
  }
  .facts {
    position: sticky;
    top: calc(var(--nav-h) + 24px);
    display: grid;
    gap: 24px;
    padding: 28px;
  }
  .facts dl {
    display: grid;
    gap: 18px;
  }
  .facts dd {
    margin: 2px 0 0;
    font-weight: 500;
    line-height: 1.45;
  }
  .facts .chips {
    margin-top: 10px;
  }

  .prose {
    max-width: 40em;
    font-size: var(--step-lead);
    line-height: 1.65;
  }
  .prose :global(p),
  .prose :global(ul) {
    margin-top: 1em;
  }
  .prose :global(> :first-child) {
    margin-top: 0;
  }
  .prose :global(h2) {
    margin-top: 2em;
    font-size: var(--step-h3);
  }
  .prose :global(ul) {
    padding-left: 1.1em;
  }
  .prose :global(li + li) {
    margin-top: 0.5em;
  }
  .prose :global(strong) {
    font-weight: 500;
  }
  .prose :global(code) {
    font-size: 0.9em;
  }

  .gallery {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(24px, 3vw, 40px) var(--gap);
  }
  .gallery :global(img) {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: top left;
    border-radius: var(--radius);
    background: var(--surface);
  }
  .gallery figcaption {
    margin-top: 12px;
  }

  .next {
    position: relative;
    display: grid;
    gap: 6px;
    padding: clamp(28px, 4vw, 48px);
    text-decoration: none;
    transition: transform 400ms var(--ease-out), border-color var(--t-hover) ease;
  }
  .next__title {
    font-size: var(--step-h2);
    line-height: 1.05;
    letter-spacing: 0.005em;
    font-family: var(--display);
    font-weight: 400;
  }
  .next__arrow {
    position: absolute;
    right: clamp(28px, 4vw, 48px);
    top: 50%;
    translate: 0 -50%;
    font-size: var(--step-h2);
    transition: transform 400ms var(--ease-out);
  }
  @media (hover: hover) and (pointer: fine) {
    .next:hover {
      border-color: var(--tone-2);
    }
    .next:hover .next__arrow {
      transform: translateX(8px);
    }
  }

  @media (max-width: 860px) {
    .project-body {
      grid-template-columns: minmax(0, 1fr);
    }
    .facts {
      position: static;
      order: 2;
    }
    .gallery {
      grid-template-columns: minmax(0, 1fr);
    }
    .next__arrow {
      display: none;
    }
  }
</style>
